{
  "executor": "docker",
  "image": "clean-ledger-runner:latest",
  "max_parallel": 2,
  "runs_dir": "fleet-runs",
  "defaults": {
    "max_fixes": 1,
    "budget_usd": 20,
    "timeout_min": 180
  },
  "repos": [
    { "name": "prettytable", "url": "https://github.com/prettytable/prettytable.git", "ref": "3.18.0" },
    { "name": "node-semver", "url": "https://github.com/npm/node-semver.git", "ref": "v7.6.3", "max_fixes": 2 }
  ]
}
