{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "MultiEdit",
      "Task",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git revert:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pip install:*)",
      "Bash(pip list:*)",
      "Bash(pytest:*)",
      "Bash(bash .ledger/measure.sh)",
      "Bash(lizard:*)",
      "Bash(jscpd:*)",
      "Bash(semgrep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(security:*)",
      "Bash(open:*)",
      "Bash(osascript:*)",
      "Bash(gh:*)",
      "Bash(npm publish:*)",
      "Bash(docker:*)",
      "Bash(claude:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.claude/projects/**)",
      "Read(~/.claude/sessions/**)",
      "Read(~/.claude/session-env/**)",
      "Read(~/.claude/shell-snapshots/**)",
      "Read(~/.claude/file-history/**)",
      "Read(~/.claude/backups/**)",
      "Read(~/.claude/ide/**)",
      "Read(~/.claude/telemetry/**)",
      "Read(~/.claude/todos/**)",
      "Read(~/.claude/statsig/**)",
      "Read(~/.claude/history.jsonl)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/.claude.json)",
      "Read(~/.claude/settings.json)",
      "Read(~/.claude/settings.local.json)",
      "Read(~/.claude/remote-settings.json)",
      "Read(~/.claude/policy-limits.json)",
      "Read(~/.claude/mcp-needs-auth-cache.json)",
      "Read(~/.claude.json)",
      "Read(~/Library/Keychains/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "semgrep.dev",
        "registry.npmjs.org"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.docker",
        "~/.gnupg",
        "~/.netrc",
        "~/.claude/projects",
        "~/.claude/sessions",
        "~/.claude/session-env",
        "~/.claude/shell-snapshots",
        "~/.claude/file-history",
        "~/.claude/backups",
        "~/.claude/ide",
        "~/.claude/telemetry",
        "~/.claude/todos",
        "~/.claude/statsig",
        "~/.claude/history.jsonl",
        "~/.claude/.credentials.json",
        "~/.claude/.claude.json",
        "~/.claude/settings.json",
        "~/.claude/settings.local.json",
        "~/.claude/remote-settings.json",
        "~/.claude/policy-limits.json",
        "~/.claude/mcp-needs-auth-cache.json",
        "~/.claude.json",
        "~/Library/Keychains"
      ]
    }
  }
}
