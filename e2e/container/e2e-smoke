#!/usr/bin/env bash
# Free checks inside the container: no Claude API calls, no API key needed.
set -uo pipefail
fail=0
ok()   { echo "PASS  $1"; }
bad()  { echo "FAIL  $1"; fail=1; }

echo "== tool versions"
claude --version && lizard --version && jscpd --version && semgrep --version || bad "a tool is missing"

echo "== plugin installed"
if claude plugin list 2>&1 | grep -q "clean-ledger"; then ok "clean-ledger plugin installed"; else bad "clean-ledger plugin not installed"; fi

echo "== test project"
cd /work/project
[ -z "$(git remote)" ] && ok "project has no git remote" || bad "project still has a git remote"
[ "$(git rev-parse HEAD)" = "$(cat /work/base-commit.txt)" ] && ok "project at the base commit" || bad "project not at base commit"
if python -m pytest -q -p no:cacheprovider > /tmp/smoke-tests.txt 2>&1; then
  ok "project test suite passes ($(tail -1 /tmp/smoke-tests.txt))"
else
  bad "project test suite fails"; tail -20 /tmp/smoke-tests.txt
fi

echo "== guard blocks a push in a ledger repo"
GUARD=$(find "$HOME/.claude" /opt/clean-ledger -path '*hooks/guard.py' 2>/dev/null | head -1)
tmp=$(mktemp -d) && cd "$tmp" && git init -q && mkdir .ledger && echo '{"branch":"clean-ledger"}' > .ledger/config.json
code=$(printf '{"tool_name":"Bash","tool_input":{"command":"git -C . push origin main"},"cwd":"%s"}' "$tmp" \
       | python3 "$GUARD" >/dev/null 2>&1; echo $?)
[ "$code" = "2" ] && ok "guard ($GUARD) blocks git push" || bad "guard did not block git push (exit $code)"

echo
[ "$fail" = 0 ] && echo "SMOKE: PASS" || echo "SMOKE: FAIL"
exit "$fail"
